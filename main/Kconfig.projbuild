menu "itoy OTA 配置"

config OTA_URL
    string "默认 OTA 升级服务器地址"
    default "https://api.tenclass.net/xiaozhi/ota/"
    help
        设备通过此 URL 检查固件更新和获取服务器配置。
        需要完整的 HTTP/HTTPS 地址，以 / 结尾。

# 开发板类型固定为 itoy（不可更改）
config BOARD_TYPE_ITOY_WIFI_LCD
    bool
    default y

# WiFi 配网方式 (build-time 选择)
choice ITOY_PROVISIONING_METHOD
    prompt "WiFi 配网方式"
    default ITOY_PROVISIONING_AP
    help
        选择首次配网方式。设备已存有 WiFi 凭据时直接连接，不进入配网。
        仅编译被选中的方式。

    config ITOY_PROVISIONING_AP
        bool "SoftAP + 网页配网 (默认)"
        help
            设备开启热点 Itoy-XXXX，手机连该热点后访问网页输入 WiFi 密码。

    config ITOY_PROVISIONING_BLE
        bool "蓝牙 BLE 配网 (ESP BLE Provisioning App)"
        select BT_ENABLED
        select BT_BLE_42_FEATURES_SUPPORTED
        help
            用蓝牙配网。手机用 Espressif "ESP BLE Provisioning" App 扫描
            Itoy-XXXX，输入 PoP 并选择 WiFi 输入密码。
            会开启蓝牙栈 (Bluedroid, 约 +200~400KB flash)。
            注: BT 主机用 ESP-IDF 默认 (S3 = Bluedroid, 兼容 protocomm BLE)。
            select BT_BLE_42_FEATURES_SUPPORTED 是因为 protocomm 的 simple_ble
            用传统(4.2)广播 API (esp_ble_gap_config_adv_data / start_advertising)。
endchoice

# itoy-mogu RGB 灯带配置
config ITOY_RGB_LED_COUNT
    int "WS2812B RGB 灯珠数量"
    default 1
    help
        连接在 GPIO38 (U13 连接器 DIN) 的 WS2812B 灯带灯珠数量。
        根据实际灯带长度在 menuconfig 中修改。

config ITOY_ENABLE_MOTOR
    bool "启用电机驱动 (点头/摇头步进 + 情绪手势)"
    default y
    help
        关闭则完全不初始化电机、不跑情绪里的电机手势
        (适合裸板调试 / 无电机时, 也省 ADC)。

config ITOY_ENABLE_MOTOR_TEST
    bool "启用电机测试代码 (串口命令驱动, 不使用电位器)"
    default n
    help
        启动步进电机串口命令测试 (stepper_motor 模块), 复用 UART0 / USB 串口
        (115200, 同一终端看日志 + 发命令):
          A <步数> [延时ms]   电机A(点头) 正(+)反(-)
          B <步数> [延时ms]   电机B(摇头) 正(+)反(-)
          O                   两电机断电
          H                   帮助

        重要: 本测试为纯 GPIO 半步驱动, **不使用电位器 / ADC / 软限位**,
        无需连接电位器即可验证电机接线; 也不读位置、不防堵转, 注意控制步数
        避免机械顶死。

        启用后由 stepper_motor 独占电机 GPIO, 跳过正常的 MotorControl +
        情绪电机手势 (与 ITOY_ENABLE_MOTOR 互斥; 两者都开时以测试为准)。

config ITOY_ENABLE_IMU
    bool "启用 IMU (QMI8658A)"
    default y
    help
        关闭则跳过 IMU 初始化 (裸板无 IMU 时关掉, 避免无谓 I2C 探测)。

endmenu
